{
  "name": "n8n-nodes-milvus-db",
  "version": "0.1.1",
  "description": "Milvus Vector Store node for n8n with an explicit database selector (multi-database / multi-tenant Milvus)",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "milvus",
    "vector-store"
  ],
  "license": "MIT",
  "author": "Hannan Haris (PufferSoft)",
  "homepage": "https://github.com/YOUR_GITHUB_USERNAME/n8n-nodes-milvus-db",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YOUR_GITHUB_USERNAME/n8n-nodes-milvus-db.git"
  },
  "bugs": {
    "url": "https://github.com/YOUR_GITHUB_USERNAME/n8n-nodes-milvus-db/issues"
  },
  "main": "index.js",
  "scripts": {
    "build": "rimraf dist && tsc && npm run copy:assets",
    "copy:assets": "mkdir -p dist/nodes/VectorStoreMilvusDb && cp nodes/VectorStoreMilvusDb/*.svg dist/nodes/VectorStoreMilvusDb/",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "nodes": [
      "dist/nodes/VectorStoreMilvusDb/VectorStoreMilvusDb.node.js"
    ]
  },
  "dependencies": {
    "@langchain/community": "1.1.27",
    "@langchain/core": "1.2.0",
    "@n8n/ai-utilities": "0.24.3",
    "@zilliz/milvus2-sdk-node": "^2.5.7"
  },
  "devDependencies": {
    "n8n-workflow": "2.31.3",
    "rimraf": "^5.0.0",
    "typescript": "^5.6.0"
  },
  "peerDependencies": {
    "n8n-workflow": ">=2.31.3"
  }
}
