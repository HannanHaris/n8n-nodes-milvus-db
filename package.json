{
  "name": "n8n-nodes-milvus-db",
  "version": "0.2.0",
  "description": "Milvus Vector Store node for n8n with an explicit database selector (multi-database / multi-tenant Milvus)",
  "keywords": ["n8n-community-node-package", "n8n", "milvus", "vector-store"],
  "license": "MIT",
  "author": "PufferSoft",
  "homepage": "https://github.com/HannanHaris/n8n-nodes-milvus-db",
  "repository": { "type": "git", "url": "git+https://github.com/HannanHaris/n8n-nodes-milvus-db.git" },
  "bugs": { "url": "https://github.com/HannanHaris/n8n-nodes-milvus-db/issues" },
  "main": "index.js",
  "scripts": {
    "build": "rimraf dist && tsc && npm run copy:assets",
    "copy:assets": "mkdir -p dist/nodes/VectorStoreMilvusDb && cp nodes/VectorStoreMilvusDb/*.svg dist/nodes/VectorStoreMilvusDb/",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "files": ["dist"],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "nodes": ["dist/nodes/VectorStoreMilvusDb/VectorStoreMilvusDb.node.js"]
  },
  "dependencies": {
    "@langchain/community": "1.1.41",
    "@langchain/core": "1.1.41",
    "@zilliz/milvus2-sdk-node": "^2.5.7"
  },
  "peerDependencies": { "@n8n/ai-utilities": "*" },
  "devDependencies": {
    "@n8n/ai-utilities": "0.17.0",
    "n8n-workflow": "2.23.0",
    "rimraf": "^5.0.0",
    "typescript": "5.9.2"
  }
}
